/.claude

# Compiled binary from `deno task compile`
/radia

# Release staging from scripts/build-release.sh (binaries + npm/pip shims)
/dist/

# Everything a local space writes: embedded databases, artifact blobs, and the space KEK.
# One directory by design (src/paths.ts), so this is the whole runtime footprint and deleting it
# resets local state. NEVER commit it: the KEK decrypts every blob beside it, and the database
# holds whatever the examples put in a space.
/.radia/

# Databases anywhere else (--db can point outside the runtime dir)
*.db
*.db-wal
*.db-shm

# Deno
.deno/

# Python bytecode (sdk/py)
__pycache__/
*.py[cod]

