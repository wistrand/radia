# Compiled binary from `deno task compile`
/radia

# Release staging from scripts/build-release.sh (binaries + npm/pip shims)
/dist/

# Artifact blobs for a local dev space (bytes, not source)
/.radia-blobs/

# Space KEK for local artifact encryption. NEVER commit this: it decrypts every blob in
# .radia-blobs, and it is kept OUTSIDE that directory so copying the blobs alone does not take
# the key with them.
/.radia-kek.json

# Local dev spaces (file-backed embedded storage)
*.db
*.db-wal
*.db-shm
/.radia/

# Deno
.deno/

# Python bytecode (sdk/py)
__pycache__/
*.py[cod]
