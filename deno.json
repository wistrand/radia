{
  "name": "radia",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env src/main.ts dev",
    "check": "deno check src/main.ts conformance/run.test.ts",
    "conformance": "deno test --allow-read --allow-write conformance/",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --include src/ui/index.html --output radia src/main.ts"
  },
  "imports": {
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.2.0"
  }
}
