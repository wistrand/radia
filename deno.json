{
  "name": "radia",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env src/main.ts dev",
    "dev:pg": "deno run --allow-net --allow-read --allow-write --allow-env src/main.ts dev --storage postgres --db postgres://radia:radia@localhost:5432/radia --blobs .radia/blobs --blob-kek .radia/kek.json",
    "check": "deno check src/main.ts conformance/run.test.ts extensions/ts/*.ts extensions/conformance/*.ts examples/pipeline/demo.ts examples/stress/stress.ts examples/chat/*.ts examples/chat/*/*.ts bench/run.ts",
    "dev:pg:oidc:s3": "RADIA_S3_ACCESS_KEY_ID=radialocal RADIA_S3_SECRET_ACCESS_KEY=radialocal  deno run -A src/main.ts dev --port 7788 --db .radia/space --oidc-issuer http://localhost:8080/realms/radia --oidc-audience radia-console --blobs 's3://radia/blobs?endpoint=http://127.0.0.1:9000'",
    "conformance": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run=python3 conformance/",
    "conformance-pg": "deno test --allow-read --allow-write --allow-env --allow-net conformance/run.test.ts conformance/planner.test.ts conformance/concurrency.test.ts",
    "conformance-s3": "deno test --allow-read --allow-write --allow-env --allow-net --filter \"[blobs:s3\" conformance/run.test.ts",
    "py-parity": "./docker/py-parity/run.sh",
    "quick": "deno test --allow-read --allow-write --allow-env --allow-net conformance/layering.test.ts conformance/docs.test.ts conformance/openapi.test.ts conformance/console.test.ts conformance/defaults.test.ts conformance/registry.test.ts conformance/tasks.test.ts conformance/http.test.ts conformance/flows.test.ts conformance/tree.test.ts",
    "extensions": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run --unstable-worker-options extensions/conformance/",
    "workspace-git": "deno run --allow-net --allow-read --allow-write --allow-env extensions/ts/export-git.ts",
    "chat-test": "deno run -A examples/chat/smoke.ts",
    "bench": "deno run --allow-read --allow-write --allow-env --allow-net bench/run.ts",
    "profile": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run bench/profile.ts",
    "demo": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run examples/pipeline/demo.ts",
    "demo:ci": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run examples/pipeline/demo.ts --once",
    "stress": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run examples/stress/stress.ts",
    "analysis": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run examples/analysis/run.ts",
    "analysis-test": "deno run -A examples/analysis/smoke.ts",
    "chat": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run examples/chat/chat.ts",
    "chat-web": "deno run --allow-net --allow-read=examples/chat/web examples/chat/web/serve.ts",
    "bundle-chat-web": "deno bundle --minify -o examples/chat/web/app.js examples/chat/web/app.ts",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --include src/ui/index.html --include src/ui/vendor/blitzoom.bundle.js --output radia src/main.ts",
    "release": "./scripts/build-release.sh",
    "bundle-browser": "./scripts/build-browser.sh",
    "serve-docs": "deno run --allow-net=127.0.0.1 --allow-read=docs scripts/serve-docs.ts",
    "mcp": "deno run --allow-net --allow-read --allow-write --allow-env src/main.ts mcp"
  },
  "imports": {
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.2.0",
    "@db/postgres": "jsr:@db/postgres@^0.19.0"
  }
}
